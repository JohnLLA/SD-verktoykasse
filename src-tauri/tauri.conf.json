{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLAs verktøykasse",
  "version": "0.1.0",
  "identifier": "no.lla.verktoykasse",
  "build": {
    "frontendDist": "ui-stub"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "LLAs verktøykasse",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
